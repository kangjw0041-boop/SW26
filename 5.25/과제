import os

path1 = input("첫 번째 디렉토리: ")
path2 = input("두 번째 디렉토리: ")

files1 = {}
files2 = {}

with os.scandir(path1) as it:
    for entry in it:

        if entry.is_file():

            size = entry.stat().st_size

            with open(entry.path, "rb") as f:
                content = f.read()

            files1[entry.name] = (size, content)

with os.scandir(path2) as it:
    for entry in it:

        if entry.is_file():

            size = entry.stat().st_size

            with open(entry.path, "rb") as f:
                content = f.read()

            files2[entry.name] = (size, content)


if files1 == files2:
    print("두 디렉토리는 동일합니다.")

else:
    print("두 디렉토리는 다릅니다.")